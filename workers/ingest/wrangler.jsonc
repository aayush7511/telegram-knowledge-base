{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kb-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },

  // Non-secret config. Secrets (TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET)
  // go in `wrangler secret put` for prod and .dev.vars locally.
  "vars": {
    "OWNER_CHAT_ID": "0"
  },

  "queues": {
    "producers": [{ "binding": "JOB_QUEUE", "queue": "kb-jobs" }]
  },
  "r2_buckets": [{ "binding": "RAW_MEDIA", "bucket_name": "kb-raw-media" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kb-jobs",
      // placeholder — replace with the real id from `wrangler d1 create kb-jobs` before deploy
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
