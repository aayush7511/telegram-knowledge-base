{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kb-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },

  // Non-secret config. Secrets (TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET)
  // go in `wrangler secret put` for prod and .dev.vars locally.
  "vars": {
    "OWNER_CHAT_ID": "7701521936"
  },

  "queues": {
    "producers": [{ "binding": "JOB_QUEUE", "queue": "kb-jobs" }]
  },
  "r2_buckets": [{ "binding": "RAW_MEDIA", "bucket_name": "kb-raw-media" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kb-jobs",
      "database_id": "0a2d2a39-fd46-47f3-8918-a3c5f6e2191a",
      "migrations_dir": "migrations"
    }
  ]
}
